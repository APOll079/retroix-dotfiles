    // Rank of one entry for the lower-case query q (already trimmed), or -1 for no match
    function rank(entry, q) {
        const name = entry[1];
        const kws = entry[2].split(" ");
        if (name === q)
            return 0;
        if (name.startsWith(q))
            return 1;
        if (kws.indexOf(q) >= 0)
            return 2;
        if (kws.some(k => k.startsWith(q)))
            return 3;
        const words = name.split(" ");
        if (words.some(w => w.startsWith(q)))
            return 4;
        if (name.indexOf(q) >= 0)
            return 5;
        if (kws.some(k => k.indexOf(q) >= 0))
            return 6;
        const parts = q.split(/\s+/);
        if (parts.length > 1) {
            const all = words.concat(kws);
            if (parts.every(p => all.some(w => w.startsWith(p))))
                return 7;
        }
        return -1;
    }

    // [{ char, name, keywords }] best first, at most `limit`. An empty query lists the first ones of the table.
    function search(query, limit) {
        const q = String(query).toLowerCase().trim();
        const max = limit > 0 ? limit : 50;
        const out = [];
        if (q === "") {
            for (let i = 0; i < Math.min(max, root.table.length); i++)
                out.push({ char: root.table[i][0], name: root.table[i][1], keywords: root.table[i][2] });
            return out;
        }
        const scored = [];
        for (let i = 0; i < root.table.length; i++) {
            const r = root.rank(root.table[i], q);
            if (r >= 0)
                scored.push({ r: r, i: i });
        }
        scored.sort((a, b) => a.r - b.r || a.i - b.i);
        for (const s of scored.slice(0, max))
            out.push({ char: root.table[s.i][0], name: root.table[s.i][1], keywords: root.table[s.i][2] });
        return out;
    }
