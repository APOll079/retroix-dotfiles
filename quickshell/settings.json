{
    "settings": {
        "audio": {
            "eqOutputMatch": "DM15",
            "eqPresets": []
        },
        "bar": {
            "fontSize": 12,
            "monochromeTrayIcons": true,
            "trayIconSize": 20
        },
        "currentTheme": "dusty",
        "execCommands": {
            "files": "nemo",
            "terminal": "kitty",
            "terminalClassFlag": "--class"
        },
        "idle": {
            "dimMinutes": 5,
            "enabled": true,
            "lockMinutes": 10,
            "screenOffMinutes": 15
        },
        "militaryTimeClockFormat": true,
        "notifications": {
            "dnd": false,
            "maxVisible": 4,
            "monitor": "",
            "position": "top-right"
        },
        "memoryWatch": {
            "cooldownMinutes": 30,
            "enabled": true,
            "ramPercent": 90,
            "tmpGb": 4
        },
        "record": {
            "dir": "~/Videos",
            "replaySeconds": 30
        },
        "diskWatch": {
            "cooldownMinutes": 60,
            "enabled": true,
            "mounts": [
                "/",
                "~",
                "/mnt/disk1",
                "/mnt/disk2"
            ],
            "percent": 90
        },
        "cleanup": {
            "shotDays": 30
        },
        "networkWatch": {
            "cooldownSeconds": 60,
            "enabled": true,
            "hosts": [],
            "vpn": true
        },
        "osd": {
            "bluetooth": true,
            "volume": true
        },
        "session": {
            "countdownSeconds": 0,
            "customActions": []
        },
        "systemDetails": {
            "cpu": "Ryzen 7 7800X3D",
            "gpu": "RX 9070 XT",
            "osName": "Artix",
            "osVersion": "Hyprland",
            "ram": "32GB 6200MHz"
        },
        "systemProfileImageSource": "~/Pictures/profile.PNG",
        "wallpaper": {
            "folder": "~/Pictures/wallpapers"
        },
        "ui": {
            "dither": true,
            "reduceMotion": false
        },
        "weather": {
            "location": "",
            "metric": true
        }
    }
}
