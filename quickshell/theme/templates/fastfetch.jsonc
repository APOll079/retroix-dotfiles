{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // Generated by quickshell/theme/apply.py from quickshell/theme/themes.json (theme: {{theme}}). Edit the template in quickshell/theme/templates/, not this file.
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "color": { "1": "38;2;{{term_accent.rgb}}" }
  },
  "modules": [
    {
      "type": "custom",
      "key": "",
      "format": "─── System ─────────────────────────────",
      "outputColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "38;2;{{term_accent.rgb}}",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "38;2;{{base.rgb}}"
    },
    {
      "type": "packages",
      "key": " Packages",
      "keyColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "command",
      "key": " Shell",
      "keyColor": "38;2;{{base.rgb}}",
      "text": "echo fish $(fish --version | cut -d' ' -f3) · kitty $(kitty --version | cut -d' ' -f2)"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "cursor",
      "key": " Cursor",
      "keyColor": "38;2;{{base.rgb}}",
      "format": "{theme}"
    },
    {
      "type": "terminalfont",
      "key": " Font",
      "keyColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "uptime",
      "key": " Uptime",
      "keyColor": "38;2;{{base.rgb}}"
    },
    {
      "type": "custom",
      "key": "",
      "format": "─── Hardware ───────────────────────────",
      "outputColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "gpu",
      "key": " GPU",
      "keyColor": "38;2;{{base.rgb}}",
      "hideType": "integrated",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "display",
      "key": " Display",
      "keyColor": "38;2;{{base.rgb}}",
      "format": "{width}x{height} @ {refresh-rate}Hz ({name})"
    },
    {
      "type": "custom",
      "key": "",
      "format": "────────────────────────────────────────",
      "outputColor": "38;2;{{term_accent.rgb}}"
    },
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    }
  ]
}
